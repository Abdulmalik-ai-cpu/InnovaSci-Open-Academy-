# ============================================
# INNOVASCI OPEN ACADEMY - ENVIRONMENT VARIABLES
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/innovasci_db"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Crisp Chat Widget
# Get your Website ID from: https://app.crisp.chat/settings/websites/
NEXT_PUBLIC_CRISP_WEBSITE_ID=""

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Resend (Email)
RESEND_API_KEY="re_your-api-key"

# Cloudflare R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="innovasci-assets"

# ============================================
# Paystack Payment Gateway
# ============================================
# Get your keys from: https://paystack.com/dashboard/settings/api
#
# Test mode keys (for development):
# - Use 'sk_test_' and 'pk_test_' prefixes
# Production mode keys (for live):
# - Use 'sk_live_' and 'pk_live_' prefixes

# Paystack Secret Key (Server-side only - NEVER expose to frontend)
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"

# Paystack Public Key (Safe to expose to frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"

# Paystack Webhook Secret (For verifying webhook signatures)
# Get this from Paystack Dashboard > Settings > Webhooks
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# ============================================
# Application Settings
# ============================================

# Application URL (for payment callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL for public-facing links (supports custom domain)
# Set this to your custom domain when ready (e.g., https://academy.innovasci.com)
# This is used for:
# - Certificate verification links
# - Payment callback URLs
# - Email links
# Priority: NEXT_PUBLIC_BASE_URL > NEXT_PUBLIC_APP_URL > request origin
NEXT_PUBLIC_BASE_URL=""

# ============================================
# RBAC SEED CREDENTIALS (PRODUCTION)
# ============================================
# IMPORTANT: Change these values before deploying to production!
# These credentials are used for seeding user accounts via db:seed-rbac

# Super Administrator (Full platform access - Administration Portal)
SUPER_ADMIN_PASSWORD="CHANGE_ME_TO_A_SECURE_PASSWORD"

# System Administrator (Technical operations - Administration Portal)
SYSTEM_ADMIN_PASSWORD="CHANGE_ME_TO_ANOTHER_SECURE_PASSWORD"

# Academic Director (Academic governance - Academic Portal)
ACADEMIC_DIRECTOR_PASSWORD="CHANGE_ME_TO_ANOTHER_SECURE_PASSWORD"

# Head of Domain (Domain management - Academic Portal)
HEAD_OF_DOMAIN_PASSWORD="CHANGE_ME_TO_ANOTHER_SECURE_PASSWORD"

# Category Lead (Category management - Academic Portal)
CATEGORY_LEAD_PASSWORD="CHANGE_ME_TO_ANOTHER_SECURE_PASSWORD"

# Instructor (Course instruction - Instructor Portal)
INSTRUCTOR_PASSWORD="CHANGE_ME_TO_ANOTHER_SECURE_PASSWORD"

# ============================================
# SEED ACCOUNT EMAILS (Reference Only)
# ============================================
# These emails are hardcoded in db:seed-rbac script:
# - SUPER_ADMIN: super@innovasci.com
# - SYSTEM_ADMIN: systemadmin@innovasci.com
# - ACADEMIC_DIRECTOR: directoracademic@innovasci.com
# - HEAD_OF_DOMAIN: head@innovasci.com
# - CATEGORY_LEAD: lead@innovasci.com
# - INSTRUCTOR: instructor@innovasci.com
